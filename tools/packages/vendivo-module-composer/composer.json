{
    "name": "vendivo/module-composer",
    "description": "Composer metadata validation and generation for Vendivo Magento modules.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "composer/composer": "^2.7",
        "nikic/php-parser": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "Vendivo\\ModuleComposer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendivo\\ModuleComposer\\Test\\": "tests/"
        }
    },
    "bin": [
        "bin/vendivo-module-composer"
    ]
}
