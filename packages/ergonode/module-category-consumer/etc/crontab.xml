<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="ergonode">
        <job name="ergonode_category_import" instance="Ergonode\CategoryConsumer\Cron\ImportCategories" method="execute">
            <config_path>ergonode_categories/cron/schedule</config_path>
        </job>
        <job name="ergonode_category_attribute_import" instance="Ergonode\CategoryConsumer\Cron\ImportCategoryData" method="execute">
            <config_path>ergonode_category_attributes/cron/schedule</config_path>
        </job>
    </group>
</config>
