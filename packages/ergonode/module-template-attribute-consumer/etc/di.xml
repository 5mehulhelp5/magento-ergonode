<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ergonode\TemplateAttributeConsumer\Api\TemplateStructureLoaderInterface" type="Ergonode\TemplateAttributeConsumer\Model\GraphQl\TemplateStructureLoader"/>
    <type name="Ergonode\TemplateConsumer\Model\Import\ImportedTemplateProcessor">
        <arguments>
            <argument name="contributors" xsi:type="array">
                <item name="template_attribute" xsi:type="object">Ergonode\TemplateAttributeConsumer\Model\Import\ImportedTemplateProcessor</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\TemplateConsumer\Model\Import\TemplateSynchronizationProcessor">
        <arguments>
            <argument name="contributors" xsi:type="array">
                <item name="template_attribute" xsi:type="object">Ergonode\TemplateAttributeConsumer\Model\Import\ImportedTemplateSynchronizer</item>
            </argument>
        </arguments>
    </type>
    <preference for="Ergonode\TemplateAttributeConsumer\Api\ManualPlacementSaverInterface" type="Ergonode\TemplateAttributeConsumer\Model\ManualPlacementSaver"/>
    <type name="Ergonode\TemplateAttribute\Model\StructureProvider">
        <arguments>
            <argument name="metadataContributors" xsi:type="array">
                <item name="consumer" xsi:type="object">Ergonode\TemplateAttributeConsumer\Model\StructureMetadataContributor</item>
            </argument>
        </arguments>
    </type>
</config>
