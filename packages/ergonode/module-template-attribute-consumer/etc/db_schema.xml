            referenceId="ERGONODE_ERGO_TMPL_ATTR_OWN_SET"
            table="ergonode_template_attribute_ownership"
            column="attribute_set_id"
            referenceTable="eav_attribute_set"
            referenceColumn="attribute_set_id"
            onDelete="CASCADE"
        />
        <constraint
            xsi:type="foreign"
            referenceId="ERGONODE_ERGO_TMPL_ATTR_OWN_ATTRIBUTE"
            table="ergonode_template_attribute_ownership"
            column="magento_attribute_id"
