            <column name="template_code"/>
            <column name="attribute_set_id"/>
            <column name="ergonode_attribute_code"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_ERGO_TMPL_ATTR_OWN_ENTITY_ATTR_ID">
