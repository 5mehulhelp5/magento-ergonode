$attributeSetActionsLabel = __('Attribute set actions: Magento');
$showExcludedHint = __('Show excluded templates and attribute sets');
$hideExcludedHint = __('Hide excluded templates and attribute sets');
$sectionNavigation = $block->getLayout()->createBlock(
    SectionNavigation::class,
    '',
    ['data' => ['current_section' => Index::NAVIGATION_SECTION]]
);
$cardSelectionHtml = $block->getLayout()->createBlock(Template::class)
