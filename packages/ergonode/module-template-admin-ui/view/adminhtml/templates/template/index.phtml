<?php
declare(strict_types=1);

use Ergonode\CoreAdminUi\Block\Adminhtml\SectionNavigation;
use Ergonode\TemplateAdminUi\Block\Adminhtml\Template\Index;
use Magento\Framework\View\Element\Template;

/** @var \Ergonode\TemplateAdminUi\Block\Adminhtml\Template\Index $block */
$templates = $block->getTemplates();
$attributeSets = $block->getAttributeSets();
$attributeSetsById = [];
$mappedAttributeSetIds = [];
$mappedPairs = [];
$unmappedTemplates = [];
$unmappedAttributeSets = [];

foreach ($attributeSets as $attributeSet) {
    $attributeSetsById[(int)$attributeSet['id']] = $attributeSet;
}

foreach ($templates as $template) {
    $attributeSetId = $template['attribute_set_id'] ?? null;

    if ($attributeSetId !== null) {
        $attributeSetId = (int)$attributeSetId;
        $mappedAttributeSetIds[$attributeSetId] = true;
        if (isset($attributeSetsById[$attributeSetId])) {
            $mappedPairs[] = [
                'template' => $template,
                'attribute_set' => $attributeSetsById[$attributeSetId],
            ];
        }
        continue;
    }

    $unmappedTemplates[] = $template;
}

foreach ($attributeSets as $attributeSet) {
    $attributeSetId = (int)$attributeSet['id'];
    if (!isset($mappedAttributeSetIds[$attributeSetId])) {
        $unmappedAttributeSets[] = $attributeSet;
    }
}

usort(
    $mappedPairs,
    static fn (array $left, array $right): int => strcmp(
        (string)$left['template']['code'],
        (string)$right['template']['code']
    )
);

$visibleUnmappedTemplateCount = count(array_filter(
    $unmappedTemplates,
    static fn (array $template): bool => ($template['active'] ?? true) !== false
));
$visibleUnmappedAttributeSetCount = count(array_filter(
    $unmappedAttributeSets,
    static fn (array $attributeSet): bool => ($attributeSet['active'] ?? true) !== false
));
$ergonodeIconUrl = $block->getViewFileUrl('Ergonode_CoreAdminUi::images/m2_configuration.svg');
$magentoIconUrl = $block->getViewFileUrl('Ergonode_CoreAdminUi::images/magento-mark.svg');
