<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ergonode\Product\Api\MagentoIdentityAttributeInterface" type="Ergonode\Product\Model\ResourceModel\MagentoIdentityAttribute"/>
    <preference for="Ergonode\Product\Api\ProductIdentityModeProviderInterface" type="Ergonode\Product\Model\Config\ProductIdentityModeProvider"/>
    <type name="Ergonode\Product\Model\Config\ProductIdentityModeProvider">
        <arguments>
            <argument name="magentoIdentityAttribute" xsi:type="object">Ergonode\Product\Api\MagentoIdentityAttributeInterface</argument>
        </arguments>
    </type>
    <preference for="Ergonode\Product\Api\ProductIdentityServiceInterface" type="Ergonode\Product\Model\ResourceModel\ProductIdentityService"/>
    <type name="Magento\Catalog\Model\ProductRepository">
        <plugin name="ergonode_product_identity_extension_attribute" type="Ergonode\Product\Plugin\ProductRepositoryIdentityPlugin"/>
    </type>
    <preference for="Ergonode\Product\Api\ProductCatalogInterface" type="Ergonode\Product\Model\ResourceModel\ProductCatalog"/>
    <type name="Ergonode\Product\Model\Cache\ProductStateSnapshots">
        <arguments><argument name="providers" xsi:type="array">
            <item name="attributes" xsi:type="object">Ergonode\Product\Model\ResourceModel\ProductStateSnapshot</item>
        </argument></arguments>
    </type>
</config>
