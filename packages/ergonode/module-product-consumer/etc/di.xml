<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ergonode\ProductConsumer\Api\ProductTypeAdapterPoolInterface" type="Ergonode\ProductConsumer\Model\Type\ProductTypeAdapterPool"/>
    <preference for="Ergonode\ProductConsumer\Model\Port\ProductImportWorkRepositoryInterface" type="Ergonode\ProductConsumer\Model\ResourceModel\ProductImportWorkRepository"/>
    <virtualType name="Ergonode\ProductConsumer\Model\Type\SimpleProductTypeAdapter" type="Ergonode\ProductConsumer\Model\Type\NoRelationTypeAdapter">
        <arguments>
            <argument name="magentoType" xsi:type="string">simple</argument>
            <argument name="ergonodeType" xsi:type="string">simple</argument>
            <argument name="defaultForErgonodeType" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>
    <virtualType name="Ergonode\ProductConsumer\Model\Type\VirtualProductTypeAdapter" type="Ergonode\ProductConsumer\Model\Type\NoRelationTypeAdapter">
        <arguments>
            <argument name="magentoType" xsi:type="string">virtual</argument>
            <argument name="ergonodeType" xsi:type="string">simple</argument>
        </arguments>
    </virtualType>
    <type name="Ergonode\ProductConsumer\Model\Type\ProductTypeAdapterPool">
        <arguments>
            <argument name="adapters" xsi:type="array">
                <item name="simple" xsi:type="object">Ergonode\ProductConsumer\Model\Type\SimpleProductTypeAdapter</item>
                <item name="virtual" xsi:type="object">Ergonode\ProductConsumer\Model\Type\VirtualProductTypeAdapter</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ergonode_products_import" xsi:type="object">Ergonode\ProductConsumer\Console\Command\ImportProductsCommand</item>
            </argument>
        </arguments>
    </type>
    <preference for="Ergonode\ProductConsumer\Api\ProductImportBatchInterface" type="Ergonode\ProductConsumer\Model\Import\ProductImportBatch"/>
    <preference for="Ergonode\ProductConsumer\Api\ProductImportReadinessInterface" type="Ergonode\ProductConsumer\Model\Import\ProductImportReadiness"/>
    <preference for="Ergonode\ProductConsumer\Model\Port\SelectedProductWriterInterface" type="Ergonode\ProductConsumer\Model\ResourceModel\SelectedProductWriter"/>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="environment" xsi:type="array">
                <item name="ergonode_products/import/enabled" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Pipeline\ProductBatchPipeline">
        <arguments>
            <argument name="lock" xsi:type="object">Ergonode\Product\Model\Synchronization\ProductSynchronizationLock</argument>
            <argument name="preprocessors" xsi:type="array">
                <item name="010_source" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\LoadSources</item>
                <item name="020_targets" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\PrepareTargets</item>
            </argument>
            <argument name="processors" xsi:type="array">
                <item name="100_attributes" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\WriteProductData</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Queue\ProductImportProcessor">
        <arguments><argument name="batchScope" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\BatchScope</argument></arguments>
    </type>
    <type name="Magento\Catalog\Model\Product">
        <plugin name="ergonode_batch_defer_product_cache" type="Ergonode\ProductConsumer\Plugin\DeferProductCache"/>
    </type>
    <type name="Magento\Framework\Event\Manager">
        <plugin name="ergonode_batch_defer_cache_event" type="Ergonode\ProductConsumer\Plugin\DeferProductCache"/>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Queue\ProductImportConsumer">
        <arguments>
            <argument name="pipeline" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\ProductBatchPipeline</argument>
        </arguments>
        <plugin name="ergonode_serialize_product_worker" type="Ergonode\Product\Plugin\SerializeProductWorkers"/>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Import\ProductImportBatch">
        <arguments><argument name="pipeline" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\ProductBatchPipeline</argument></arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\ResourceModel\ProductImportWorkRepository">
        <arguments><argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument></arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Import\SelectedProductImporter">
        <arguments><argument name="batchScope" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\BatchScope</argument></arguments>
    </type>

</config>
