<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ergonode\CategoryAttributePublisher\Api\MagentoOptionLabelReaderInterface" type="Ergonode\CategoryAttributePublisher\Model\ResourceModel\MagentoOptionLabelReader"/>
    <preference
        for="Ergonode\CategoryAttributePublisher\Api\WriteScopeCategoryAttributeCodeLoaderInterface"
        type="Ergonode\CategoryAttributePublisher\Model\GraphQl\WriteScopeCategoryAttributeCodeLoader"
    />
    <preference for="Ergonode\CategoryAttributePublisher\Api\CategoryAttributeStateFactoryInterface" type="Ergonode\CategoryAttributePublisher\Model\Data\CategoryAttributeStateFactory"/>
    <preference
        for="Ergonode\CategoryAttributePublisher\Api\CategoryAttributeRegistrySynchronizerInterface"
        type="Ergonode\CategoryAttributePublisher\Model\Sync\CategoryAttributeRegistrySynchronizer"
    />
    <type name="Ergonode\CategoryPublisher\Model\Sync\CategorySyncPlanner">
        <arguments>
            <argument name="contributors" xsi:type="array">
                <item name="category_attributes" xsi:type="object">Ergonode\CategoryAttributePublisher\Model\Sync\CategoryAttributeSynchronizationContributor</item>
            </argument>
        </arguments>
    </type>
</config>
