<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Ergonode\ProductConsumer\Model\Queue\ProductImportHashProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="media" xsi:type="object">Ergonode\ProductMediaConsumer\Model\Media\MediaImportHashProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\GraphQl\ProductAttributeCodeProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="media" xsi:type="object">Ergonode\ProductMediaConsumer\Model\GraphQl\MediaAttributeCodeProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Magento\ProductAttributeMappingDeferrerPool">
        <arguments>
            <argument name="deferrers" xsi:type="array">
                <item name="media_file" xsi:type="object">Ergonode\ProductMediaConsumer\Model\Magento\AsynchronousFileAttributeMapping</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Magento\ProductStateSynchronizerPool">
        <arguments>
            <argument name="synchronizers" xsi:type="array">
                <item name="media" xsi:type="object">Ergonode\ProductMediaConsumer\Model\Media\ProductMediaSynchronizer</item>
            </argument>
        </arguments>
    </type>

    <type name="Ergonode\ProductMedia\Model\Mapping\ImageValueAdapter">
        <arguments>
            <argument name="importEnabled" xsi:type="boolean">true</argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Magento\SelectedProductStateSynchronizerPool">
        <arguments>
            <argument name="synchronizers" xsi:type="array">
                <item name="media" xsi:type="object">Ergonode\ProductMediaConsumer\Model\Media\ProductMediaSynchronizer</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\ProductConsumer\Model\Pipeline\ProductBatchPipeline">
        <arguments><argument name="processors" xsi:type="array">
            <item name="200_media" xsi:type="object">Ergonode\ProductMediaConsumer\Model\Pipeline\WriteProductMedia</item>
        </argument></arguments>
    </type>
    <type name="Ergonode\ProductMediaConsumer\Model\Media\ProductMediaSynchronizer">
        <arguments><argument name="batchScope" xsi:type="object">Ergonode\ProductConsumer\Model\Pipeline\BatchScope</argument></arguments>
    </type>
    <type name="Ergonode\Media\Model\Queue\QueuePublisher">
        <plugin name="ergonode_product_inline_media" type="Ergonode\ProductMediaConsumer\Plugin\InlineMediaDispatch"/>
    </type>
</config>
