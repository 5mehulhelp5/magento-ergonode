<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ergonode\Media\Model\Port\ScanStateInterface" type="Ergonode\Media\Model\ResourceModel\ScanState"/>
    <preference for="Ergonode\Media\Api\ScanRequesterInterface" type="Ergonode\Media\Model\Index\ScanRequest"/>
    <preference for="Ergonode\Media\Api\ScanStatusProviderInterface" type="Ergonode\Media\Model\Index\ScanStatusProvider"/>
    <preference for="Ergonode\Media\Api\GalleryAttributeOptionsInterface" type="Ergonode\Media\Model\GraphQl\GalleryAttributeOptions"/>
    <preference for="Ergonode\Media\Model\Port\LocalFileIndexInterface" type="Ergonode\Media\Model\ResourceModel\LocalFileIndex"/>
    <preference for="Ergonode\Media\Api\GalleryModeLockInterface" type="Ergonode\Media\Model\ResourceModel\GalleryModeLock"/>
    <preference for="Ergonode\Media\Api\GallerySchedulerInterface" type="Ergonode\Media\Model\Gallery\GalleryScheduler"/>
    <preference for="Ergonode\Media\Api\FileUsageRecorderInterface" type="Ergonode\Media\Model\File\FileUsageRecorder"/>
    <preference for="Ergonode\Media\Api\SharedAssetResolverInterface" type="Ergonode\Media\Model\Materialization\SharedAssetResolver"/>
    <preference for="Ergonode\Media\Api\SharedPathStrategyInterface" type="Ergonode\Media\Model\Materialization\DefaultSharedPathStrategy"/>
