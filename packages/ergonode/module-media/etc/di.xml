    <preference for="Ergonode\Media\Model\Port\FileAttributeWriterInterface" type="Ergonode\Media\Model\ResourceModel\FileAttributeWriter"/>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ergonode_media_scan" xsi:type="object">Ergonode\Media\Console\Command\ScanFilesCommand</item>
                <item name="ergonode_media_list" xsi:type="object">Ergonode\Media\Console\Command\ListFilesCommand</item>
                <item name="ergonode_media_schedule" xsi:type="object">Ergonode\Media\Console\Command\ScheduleMediaCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="environment" xsi:type="array"/>
        </arguments>
    </type>

    <virtualType name="Ergonode\Media\Model\GraphQl\ImageAttributeOptions" type="Ergonode\Media\Model\GraphQl\GalleryAttributeOptions">
        <arguments>
            <argument name="attributeType" xsi:type="string">ImageAttribute</argument>
        </arguments>
    </virtualType>
    <preference for="Ergonode\Media\Api\ImageAttributeOptionsInterface" type="Ergonode\Media\Model\GraphQl\ImageAttributeOptions"/>
</config>
