<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ergonode_category_history_operation" resource="default" engine="innodb" comment="Ergonode Category History Operations">
        <column xsi:type="bigint" name="operation_id" unsigned="true" nullable="false" identity="true" comment="Operation ID"/>
        <column xsi:type="varchar" name="operation_code" nullable="false" length="64" comment="Operation Code"/>
        <column xsi:type="varchar" name="origin" nullable="false" length="24" comment="Operation Origin"/>
        <column xsi:type="varchar" name="status" nullable="false" length="24" comment="Operation Status"/>
        <column xsi:type="int" name="actor_id" unsigned="true" nullable="true" comment="Admin User ID"/>
        <column xsi:type="varchar" name="actor_name" nullable="true" length="255" comment="Admin User Name"/>
        <column xsi:type="mediumtext" name="summary_json" nullable="true" comment="Operation Summary JSON"/>
        <column xsi:type="timestamp" name="started_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Started At"/>
        <column xsi:type="timestamp" name="finished_at" nullable="true" on_update="false" comment="Finished At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="operation_id"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_HISTORY_OPERATION_ORIGIN_STARTED" indexType="btree">
            <column name="origin"/>
            <column name="started_at"/>
        </index>
        <index referenceId="ERGONODE_CATEGORY_HISTORY_OPERATION_STATUS_STARTED" indexType="btree">
            <column name="status"/>
            <column name="started_at"/>
        </index>
    </table>
    <table name="ergonode_category_history_change_set" resource="default" engine="innodb" comment="Ergonode Category History Tree Change Sets">
        <column xsi:type="bigint" name="change_set_id" unsigned="true" nullable="false" identity="true" comment="Change Set ID"/>
        <column xsi:type="bigint" name="operation_id" unsigned="true" nullable="false" comment="Operation ID"/>
        <column xsi:type="int" name="category_tree_id" unsigned="true" nullable="false" comment="Category Tree ID"/>
        <column xsi:type="varchar" name="tree_code" nullable="false" length="255" comment="Ergonode Category Tree Code"/>
        <column xsi:type="int" name="root_category_id" unsigned="true" nullable="false" comment="Magento Root Category ID"/>
        <column xsi:type="varchar" name="root_label" nullable="false" length="255" comment="Magento Root Category Label"/>
        <column xsi:type="varchar" name="before_hash" nullable="false" length="64" comment="State Hash Before Operation"/>
        <column xsi:type="varchar" name="after_hash" nullable="false" length="64" comment="State Hash After Operation"/>
        <column xsi:type="mediumtext" name="summary_json" nullable="false" comment="Change Summary JSON"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="change_set_id"/>
        </constraint>
        <constraint
            xsi:type="foreign"
            referenceId="ERGONODE_CATEGORY_HISTORY_SET_OPERATION_FK"
            table="ergonode_category_history_change_set"
            column="operation_id"
            referenceTable="ergonode_category_history_operation"
            referenceColumn="operation_id"
            onDelete="CASCADE"
        />
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_HISTORY_SET_OPERATION_TREE">
            <column name="operation_id"/>
            <column name="category_tree_id"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_HISTORY_SET_TREE_OPERATION" indexType="btree">
            <column name="category_tree_id"/>
            <column name="operation_id"/>
        </index>
    </table>
    <table name="ergonode_category_history_change" resource="default" engine="innodb" comment="Ergonode Category History Reversible Changes">
        <column xsi:type="bigint" name="change_id" unsigned="true" nullable="false" identity="true" comment="Change ID"/>
        <column xsi:type="bigint" name="change_set_id" unsigned="true" nullable="false" comment="Change Set ID"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="16" comment="Source or Target Entity Type"/>
        <column xsi:type="varchar" name="entity_identifier" nullable="false" length="255" comment="Entity Identifier"/>
        <column xsi:type="varchar" name="category_code" nullable="true" length="255" comment="Related Ergonode Category Code"/>
        <column xsi:type="text" name="actions_json" nullable="false" comment="Effective Actions JSON"/>
        <column xsi:type="mediumtext" name="before_state" nullable="true" comment="Entity State Before Operation"/>
        <column xsi:type="mediumtext" name="after_state" nullable="true" comment="Entity State After Operation"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="change_id"/>
        </constraint>
        <constraint
            xsi:type="foreign"
            referenceId="ERGONODE_CATEGORY_HISTORY_CHANGE_SET_FK"
            table="ergonode_category_history_change"
            column="change_set_id"
            referenceTable="ergonode_category_history_change_set"
            referenceColumn="change_set_id"
            onDelete="CASCADE"
        />
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_HISTORY_CHANGE_SET_ENTITY">
            <column name="change_set_id"/>
            <column name="entity_type"/>
            <column name="entity_identifier"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_HISTORY_CHANGE_CATEGORY_CODE" indexType="btree">
            <column name="category_code"/>
        </index>
    </table>
</schema>
