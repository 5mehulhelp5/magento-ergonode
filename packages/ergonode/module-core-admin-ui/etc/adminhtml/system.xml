<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="ergonode" translate="label" sortOrder="900" class="ergonode-tab">
            <label>Ergonode</label>
        </tab>
        <section id="ergonode_connection" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Connection</label>
            <tab>ergonode</tab>
            <resource>Ergonode_Core::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\OpenFieldset</frontend_model>
                <field id="enabled" translate="label" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0" type="select">
                    <label>Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="environment" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" type="select">
                    <label>Active environment</label>
                    <source_model>Ergonode\CoreAdminUi\Model\Config\Source\Environment</source_model>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\Environment</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="mode" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" type="select">
                    <label>Operating mode</label>
                    <source_model>Ergonode\CoreAdminUi\Model\Config\Source\OperatingMode</source_model>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\OperatingMode</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="test" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Test</label>
                <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\OpenFieldset</frontend_model>
                <depends>
                    <field id="ergonode_connection/general/enabled">1</field>
                    <field id="ergonode_connection/general/environment">test</field>
                </depends>
                <field id="url" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" type="text">
                    <label>URL</label>
                    <comment>Use https://tenant.ergonode.cloud. Required for the active environment when the connection is enabled.</comment>
                    <validate>required-entry validate-url</validate>
                    <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\RequiredField</frontend_model>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\ErgonodeUrl</backend_model>
                </field>
                <field id="requests_per_minute" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" type="text">
                    <label>Requests per minute</label>
                    <comment
                    >Shared by all GraphQL requests to this environment, including connection tests and retries. 0 disables the limit. Resets at the start of each minute. Save changes before testing.</comment>
                    <validate>required-entry validate-digits</validate>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\RequestsPerMinute</backend_model>
                    <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\RequiredField</frontend_model>
                </field>
            </group>
            <group id="production" translate="label" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Production</label>
                <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\OpenFieldset</frontend_model>
                <depends>
                    <field id="ergonode_connection/general/enabled">1</field>
                    <field id="ergonode_connection/general/environment">production</field>
                </depends>
                <field id="url" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" type="text">
                    <label>URL</label>
                    <comment>Use https://tenant.ergonode.cloud. Required for the active environment when the connection is enabled.</comment>
                    <validate>required-entry validate-url</validate>
                    <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\RequiredField</frontend_model>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\ErgonodeUrl</backend_model>
                </field>
                <field id="requests_per_minute" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" type="text">
                    <label>Requests per minute</label>
                    <comment
                    >Shared by all GraphQL requests to this environment, including connection tests and retries. 0 disables the limit. Resets at the start of each minute. Save changes before testing.</comment>
                    <validate>required-entry validate-digits</validate>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\RequestsPerMinute</backend_model>
                    <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\RequiredField</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
