        'workspace_id' => $workspaceId,
        'module_name' => 'Ergonode_CoreAdminUi/js/attribute-mapping',
        'config_json' => $block->getMappingConfigJson(),
    ]
);
$sectionNavigation = $block->getLayout()->createBlock(
    SectionNavigation::class,
    '',
    ['data' => ['current_section' => $block->getCurrentNavigationSection()]]
);
$cardSelectionHtml = $block->getLayout()->createBlock(Template::class)
