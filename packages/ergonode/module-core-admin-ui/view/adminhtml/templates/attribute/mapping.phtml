<?php
declare(strict_types=1);

use Ergonode\CoreAdminUi\Block\Adminhtml\SectionNavigation;
use Ergonode\CoreAdminUi\Block\Adminhtml\SynchronizationActions;
use Magento\Framework\View\Element\Template;

/** @var \Ergonode\ProductAttributeAdminUi\Block\Adminhtml\Attribute\Mapping $block */
$sidebarHtml = trim($block->getChildHtml('sidebar'));
$ergonodeAttributes = $block->getErgonodeAttributes();
$magentoAttributes = $block->getMagentoAttributes();
$canCreateMagentoAttributes = $block->canCreateMagentoAttributes();
$existingMagentoAttributeCodes = $canCreateMagentoAttributes
    ? array_fill_keys(
        array_map(
            static fn (string $code): string => strtolower(trim($code)),
            $block->getExistingMagentoAttributeCodes()
        ),
        true
    )
    : [];
$draftMappings = $block->getDraftMappings();
$mappedAttributes = $block->getMappedAttributes();
$canSynchronizeAttributes = $block->canSynchronizeAttributes();
$mappedCodes = ['ergo' => [], 'magento' => []];
foreach (array_merge($draftMappings, $mappedAttributes) as $mapping) {
    foreach (['left' => 'ergo', 'right' => 'magento'] as $side => $source) {
        $code = trim((string)($mapping[$side]['code'] ?? ''));
        if ($code !== '') {
            $mappedCodes[$source][$code] = true;
        }
    }
}
$typeClass = static function (string $type): string {
    return 'vea-type-' . (preg_replace('/[^a-z0-9_-]+/', '-', strtolower(trim($type))) ?: 'unknown');
};
$isActiveAttribute = static function (array $attribute): bool {
    if (array_key_exists('active', $attribute)) {
        return (bool)$attribute['active'];
    }

    return strtolower((string)($attribute['scope'] ?? '')) !== 'ignore';
};
$canCreateMagentoAttribute = static function (string $type) use ($canCreateMagentoAttributes): bool {
    return $canCreateMagentoAttributes
        && !in_array(strtolower(trim($type)), ['', 'gallery', 'relation'], true);
};
$requirementTooltipId = static function (string $source, string $code): string {
    return 'attribute-mapping-requirement-' . substr(hash('sha256', $source . ':' . $code), 0, 12);
};
$ergonodeIconUrl = $block->getViewFileUrl('Ergonode_CoreAdminUi::images/m2_configuration.svg');
$magentoIconUrl = $block->getViewFileUrl('Ergonode_CoreAdminUi::images/magento-mark.svg');
$saveIconUrl = $block->getViewFileUrl('Ergonode_CoreAdminUi::images/save.svg');
$autoMatchTitle = __('Automatycznie dopasuj aktywne atrybuty');
$showExcludedHint = __('Pokaż atrybuty pominięte w mapowaniu');
$hideExcludedHint = __('Ukryj atrybuty pominięte w mapowaniu');
$renderPartial = static function (Template $context, string $template, array $data): string {
    return $context->getLayout()
        ->createBlock(Template::class)
        ->setTemplate($template)
        ->setData($data)
        ->toHtml();
};
$sourceStateActionsHtml = $renderPartial(
    $block,
    'Ergonode_CoreAdminUi::entity/source-state-actions.phtml',
    [
        'show_excluded_hint' => $showExcludedHint,
        'hide_excluded_hint' => $hideExcludedHint,
    ]
);
$mappingActionsHtml = $renderPartial(
    $block,
    'Ergonode_CoreAdminUi::mapping/actions.phtml',
    [
        'search_placeholder' => __('Szukaj: nazwa, kod...'),
        'save_title' => __('Zapisz mapowanie'),
        'save_icon_url' => $saveIconUrl,
        'auto_match_title' => $autoMatchTitle,
        'complete_title' => __('Uzupełnij brakujące atrybuty w Ergonode i Magento'),
        'auto_match_disabled' => true,
        'complete_disabled' => true,
    ]
);
$disableDropZoneHtml = $renderPartial(
