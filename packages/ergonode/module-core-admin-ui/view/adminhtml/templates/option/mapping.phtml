    return 'vea-type-' . (preg_replace('/[^a-z0-9_-]+/', '-', strtolower(trim($type))) ?: 'unknown');
};
$isActiveOption = static function (array $option): bool {
    if (array_key_exists('active', $option)) {
        return (bool)$option['active'];
