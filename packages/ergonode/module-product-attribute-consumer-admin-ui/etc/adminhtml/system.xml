<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="ergonode_attributes" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Attributes</label>
            <tab>ergonode</tab>
            <resource>Ergonode_Core::config</resource>
            <group id="mapping" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Mapping</label>
                <field id="map_identical_codes" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Map Identical Codes</label>
                    <comment>During attribute import from cron or CLI, create a missing Magento attribute and map it only when its code is identical to the Ergonode attribute code.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="options" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Options</label>
                <field id="synchronize_sort_order" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Synchronize Sort Order</label>
                    <comment>Update Magento option positions to match their current order in Ergonode.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="delete_missing_magento_options" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Delete Missing Options</label>
                    <comment>Delete mapped table-source Magento options that are no longer returned by Ergonode. Product values using deleted options can become empty.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="cron" translate="label" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Cron</label>
                <field id="status" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Status</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="schedule" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Schedule</label>
                    <comment>Five-part cron expression in the Magento configuration timezone, for example */15 * * * *.</comment>
                    <backend_model>Ergonode\CoreAdminUi\Model\Config\Backend\CronSchedule</backend_model>
                    <frontend_model>Ergonode\CoreAdminUi\Block\Adminhtml\System\Config\RequiredField</frontend_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="status">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
