<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ergonode_category_tree_option" resource="default" engine="innodb" comment="Ergonode Category Tree Options Cache">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="code" nullable="false" length="255" comment="Ergonode Category Tree Code"/>
        <column xsi:type="mediumtext" name="labels_json" nullable="false" comment="Localized Labels JSON"/>
        <column xsi:type="mediumtext" name="raw_json" nullable="false" comment="Raw Ergonode Payload JSON"/>
        <column xsi:type="timestamp" name="synced_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Synced At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_TREE_OPTION_CODE">
            <column name="code"/>
        </constraint>
    </table>

    <table name="ergonode_category_tree" resource="default" engine="innodb" comment="Ergonode Category Trees">
        <column xsi:type="int" name="category_tree_id" unsigned="true" nullable="false" identity="true" comment="Category Tree ID"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="varchar" name="tree_code" nullable="false" length="255" comment="Ergonode Category Tree Code"/>
        <column xsi:type="int" name="root_category_id" unsigned="true" nullable="false" comment="Magento Root Category ID"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Configuration Sort Order"/>
        <column xsi:type="smallint" name="remove_missing" unsigned="true" nullable="false" default="0" comment="Delete Missing Mapped Magento Categories"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="category_tree_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_TREE_ROOT">
            <column name="root_category_id"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_TREE_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
        <index referenceId="ERGONODE_CATEGORY_TREE_CODE" indexType="btree">
            <column name="tree_code"/>
        </index>
    </table>

    <table name="ergonode_category_snapshot" resource="default" engine="innodb" comment="Ergonode Category Source Snapshot">
        <column xsi:type="int" name="snapshot_id" unsigned="true" nullable="false" identity="true" comment="Snapshot ID"/>
        <column xsi:type="int" name="category_tree_id" unsigned="true" nullable="false" comment="Category Tree ID"/>
        <column xsi:type="varchar" name="category_code" nullable="false" length="255" comment="Ergonode Category Code"/>
        <column xsi:type="varchar" name="parent_category_code" nullable="true" length="255" comment="Ergonode Parent Category Code"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Ergonode Sort Order"/>
        <column xsi:type="mediumtext" name="labels_json" nullable="false" comment="Localized Labels JSON"/>
        <column xsi:type="varchar" name="content_hash" nullable="false" length="64" comment="Normalized Content Hash"/>
        <column xsi:type="mediumtext" name="raw_json" nullable="false" comment="Raw Ergonode Payload JSON"/>
        <column xsi:type="timestamp" name="seen_at" nullable="true" default="CURRENT_TIMESTAMP" on_update="false" comment="Last Import Seen At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="snapshot_id"/>
        </constraint>
        <constraint
            xsi:type="foreign"
            referenceId="ERGONODE_CATEGORY_SNAPSHOT_CATEGORY_TREE_FK"
            table="ergonode_category_snapshot"
            column="category_tree_id"
            referenceTable="ergonode_category_tree"
            referenceColumn="category_tree_id"
            onDelete="CASCADE"
        />
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_SNAPSHOT_CATEGORY_TREE_CODE">
            <column name="category_tree_id"/>
            <column name="category_code"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_SNAPSHOT_PARENT" indexType="btree">
            <column name="category_tree_id"/>
            <column name="parent_category_code"/>
        </index>
        <index referenceId="ERGONODE_CATEGORY_SNAPSHOT_SEEN" indexType="btree">
            <column name="seen_at"/>
        </index>
    </table>

    <table name="ergonode_category_mapping" resource="default" engine="innodb" comment="Ergonode Category Magento Mapping">
        <column xsi:type="int" name="mapping_id" unsigned="true" nullable="false" identity="true" comment="Mapping ID"/>
        <column xsi:type="int" name="category_tree_id" unsigned="true" nullable="false" comment="Category Tree ID"/>
        <column xsi:type="varchar" name="ergonode_category_code" nullable="false" length="255" comment="Ergonode Category Code"/>
        <column xsi:type="varchar" name="ergonode_category_id" nullable="true" length="64" comment="Ergonode Category ID"/>
        <column xsi:type="int" name="magento_category_id" unsigned="true" nullable="true" comment="Magento Category ID"/>
        <column xsi:type="varchar" name="manual_parent_code" nullable="true" length="255" comment="Manual Parent Code"/>
        <column xsi:type="int" name="manual_sort_order" unsigned="true" nullable="true" comment="Manual Sort Order"/>
        <column xsi:type="varchar" name="sync_status" nullable="false" length="32" default="pending" comment="Magento Sync Status"/>
        <column xsi:type="text" name="sync_message" nullable="true" comment="Magento Sync Message"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="mapping_id"/>
        </constraint>
        <constraint
            xsi:type="foreign"
            referenceId="ERGONODE_CATEGORY_MAPPING_CATEGORY_TREE_FK"
            table="ergonode_category_mapping"
            column="category_tree_id"
            referenceTable="ergonode_category_tree"
            referenceColumn="category_tree_id"
            onDelete="CASCADE"
        />
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_MAPPING_CATEGORY_TREE_CODE">
            <column name="category_tree_id"/>
            <column name="ergonode_category_code"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_MAPPING_MAGENTO" indexType="btree">
            <column name="magento_category_id"/>
        </index>
        <index referenceId="ERGONODE_CATEGORY_MAPPING_STATUS" indexType="btree">
            <column name="category_tree_id"/>
            <column name="sync_status"/>
        </index>
    </table>
</schema>
