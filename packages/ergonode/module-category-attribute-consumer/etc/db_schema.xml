<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ergonode_category_attribute" resource="default" engine="innodb" comment="Ergonode Category Attribute Registry">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="attribute_code" nullable="false" length="255" comment="Ergonode Attribute Code"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_ATTRIBUTE_CODE">
            <column name="attribute_code"/>
        </constraint>
    </table>

    <table name="ergonode_category_entity_snapshot" resource="default" engine="innodb" comment="Ergonode Global Category Entity Snapshot">
        <column xsi:type="int" name="snapshot_id" unsigned="true" nullable="false" identity="true" comment="Snapshot ID"/>
        <column xsi:type="varchar" name="category_code" nullable="false" length="255" comment="Ergonode Category Code"/>
        <column xsi:type="mediumtext" name="labels_json" nullable="false" comment="Localized Labels JSON"/>
        <column xsi:type="mediumtext" name="attributes_json" nullable="false" comment="Normalized Attributes JSON"/>
        <column xsi:type="varchar" name="content_hash" nullable="false" length="64" comment="Normalized Content Hash"/>
        <column xsi:type="mediumtext" name="raw_json" nullable="false" comment="Raw Ergonode Payload JSON"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="snapshot_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_CATEGORY_ENTITY_SNAPSHOT_CODE">
            <column name="category_code"/>
        </constraint>
        <index referenceId="ERGONODE_CATEGORY_ENTITY_SNAPSHOT_HASH" indexType="btree">
            <column name="content_hash"/>
        </index>
    </table>
</schema>
