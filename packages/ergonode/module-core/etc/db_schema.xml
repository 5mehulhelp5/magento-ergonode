<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ergonode_mapping_visibility" resource="default" engine="innodb" comment="Ergonode Mapping Visibility">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="Entity Type"/>
        <column xsi:type="varchar" name="source" nullable="false" length="16" comment="Source System"/>
        <column xsi:type="varchar" name="parent_identifier" nullable="false" length="255" default="" comment="Parent Identifier"/>
        <column xsi:type="varchar" name="identifier" nullable="false" length="255" comment="Entity Identifier"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" identity="false" default="1" comment="Is Active For Mapping"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_VISIBILITY_UNQ">
            <column name="entity_type"/>
            <column name="source"/>
            <column name="parent_identifier"/>
            <column name="identifier"/>
        </constraint>
    </table>
    <table name="ergonode_import_cursor" resource="default" engine="innodb" comment="Ergonode Import Cursor State">
        <column xsi:type="varchar" name="process_code" nullable="false" length="64" comment="Import Process Code"/>
        <column xsi:type="text" name="cursor" nullable="true" comment="Last End Cursor"/>
        <column xsi:type="varchar" name="lock_token" nullable="true" length="64" comment="Current Operation Lock Token"/>
        <column xsi:type="datetime" name="started_at" nullable="true" comment="Current Operation Started At"/>
        <column xsi:type="datetime" name="completed_at" nullable="true" comment="Last Operation Completed At"/>
        <column xsi:type="datetime" name="reset_at" nullable="true" comment="Last Explicit Cursor Reset At"/>
        <column xsi:type="timestamp" name="synced_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Synced At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="process_code"/>
        </constraint>
    </table>
</schema>
