    <preference for="Ergonode\Core\Api\GraphQlWriteScopeQueryClientInterface" type="Ergonode\Core\Model\GraphQl\Client"/>
    <preference for="Ergonode\Core\Api\MappingRowsPersisterInterface" type="Ergonode\Core\Model\Mapping\MappingRowsPersister"/>
    <preference for="Ergonode\Core\Api\MappingVisibilityProviderInterface" type="Ergonode\Core\Model\Provider\VisibilityProvider"/>
    <preference for="Ergonode\Core\Api\MappingVisibilitySaverInterface" type="Ergonode\Core\Model\Provider\VisibilityProvider"/>
    <preference for="Ergonode\Core\Api\PaginatedImporterRefresherInterface" type="Ergonode\Core\Model\Import\PaginatedImporterRefresher"/>
