    <preference for="Ergonode\Core\Api\UpdateConfigurationProviderInterface" type="Ergonode\Core\Model\Config\UpdateConfigProvider"/>
    <type name="Ergonode\Core\Model\Readiness\ReadinessService">
        <arguments>
            <argument name="checks" xsi:type="array">
                <item name="ergonode_connection_configuration" xsi:type="object">Ergonode\Core\Model\Readiness\ConnectionConfigurationCheck</item>
            </argument>
        </arguments>
    </type>
    <preference for="Ergonode\Core\Api\GraphQlRequestLimiterInterface" type="Ergonode\Core\Model\GraphQl\RateLimiter"/>
    <preference for="Ergonode\Core\Api\SynchronizationMonitorInterface" type="Ergonode\Core\Model\Import\SynchronizationMonitor"/>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="environment" xsi:type="array">
                <item name="ergonode_connection/general/environment" xsi:type="string">1</item>
                <item name="ergonode_connection/general/mode" xsi:type="string">1</item>
                <item name="ergonode_connection/general/enabled" xsi:type="string">1</item>
                <item name="ergonode_connection/test/url" xsi:type="string">1</item>
                <item name="ergonode_connection/test/requests_per_minute" xsi:type="string">1</item>
                <item name="ergonode_connection/production/url" xsi:type="string">1</item>
                <item name="ergonode_connection/production/requests_per_minute" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <preference for="Ergonode\Core\Api\AutomaticSynchronizationInterface" type="Ergonode\Core\Model\Config\AutomaticSynchronization"/>
    <preference for="Ergonode\Core\Api\DownloadSourcePolicyInterface" type="Ergonode\Core\Model\Http\DownloadSourcePolicy"/>
</config>
