<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ergonode\Publisher\Api\MutationBatchBuilderInterface" type="Ergonode\Publisher\Model\GraphQl\MutationBatchBuilder"/>
    <preference for="Ergonode\Publisher\Api\MutationBatchPlannerInterface" type="Ergonode\Publisher\Model\GraphQl\MutationBatchPlanner"/>
    <preference for="Ergonode\Publisher\Api\MutationExecutorInterface" type="Ergonode\Publisher\Model\GraphQl\MutationExecutor"/>
    <preference for="Ergonode\Publisher\Api\RetryDelayInterface" type="Ergonode\Publisher\Model\GraphQl\RetryDelay"/>
    <type name="Ergonode\Publisher\Model\GraphQl\MutationBatchBuilder">
        <arguments>
            <argument name="maxOperations" xsi:type="number">50</argument>
            <argument name="maxVariablesSizeBytes" xsi:type="number">524288</argument>
        </arguments>
    </type>
    <type name="Ergonode\Publisher\Model\GraphQl\MutationExecutor">
        <arguments>
            <argument name="maxAttempts" xsi:type="number">3</argument>
            <argument name="baseDelaySeconds" xsi:type="number">1</argument>
            <argument name="transientHttpStatuses" xsi:type="array">
                <item name="internal_server_error" xsi:type="number">500</item>
                <item name="bad_gateway" xsi:type="number">502</item>
                <item name="service_unavailable" xsi:type="number">503</item>
                <item name="gateway_timeout" xsi:type="number">504</item>
            </argument>
        </arguments>
    </type>
    <type name="Ergonode\Core\Model\Config\ConnectionModePool">
        <arguments>
            <argument name="modes" xsi:type="array">
                <item name="write" xsi:type="object">Ergonode\Publisher\Model\Config\ConnectionMode</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="ergonode_connection/test/publisher/api_key" xsi:type="string">1</item>
                <item name="ergonode_connection/production/publisher/api_key" xsi:type="string">1</item>
                <item name="ergonode_connection/write_operations/api_key" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="ergonode_connection/test/publisher/api_key" xsi:type="string">1</item>
                <item name="ergonode_connection/production/publisher/api_key" xsi:type="string">1</item>
                <item name="ergonode_connection/write_operations/api_key" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <preference for="Ergonode\Publisher\Api\Rest\ClientInterface" type="Ergonode\Publisher\Model\Rest\Client"/>
    <preference for="Ergonode\Publisher\Api\Rest\ConnectionManagementInterface" type="Ergonode\Publisher\Model\Rest\ConnectionManagement"/>
    <preference for="Ergonode\Publisher\Api\Rest\ConnectionStorageInterface" type="Ergonode\Publisher\Model\ResourceModel\Rest\ConnectionStorage"/>
    <type name="Ergonode\Publisher\Model\Rest\Transport">
        <arguments>
            <argument name="curl" xsi:type="object" shared="false">Magento\Framework\HTTP\Client\Curl</argument>
        </arguments>
    </type>
</config>
