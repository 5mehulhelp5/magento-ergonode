<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ergonode_publisher_rest_connection" resource="default" engine="innodb" comment="Ergonode REST Integration Connections">
        <column xsi:type="int" name="connection_id" unsigned="true" nullable="false" identity="true" comment="Connection ID"/>
        <column xsi:type="varchar" name="profile" length="16" nullable="false" comment="Environment Profile"/>
        <column xsi:type="varchar" name="origin" length="255" nullable="false" comment="Ergonode Origin"/>
        <column xsi:type="varchar" name="email" length="255" nullable="false" comment="Integration Account Email"/>
        <column xsi:type="text" name="token" nullable="false" comment="Encrypted Access Token"/>
        <column xsi:type="text" name="refresh_token" nullable="false" comment="Encrypted Refresh Token"/>
        <column xsi:type="bigint" name="expires_at" unsigned="true" nullable="false" comment="Access Token Expiry"/>
        <column xsi:type="varchar" name="generation" length="32" nullable="false" comment="Login Generation"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="connection_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERGONODE_PUBLISHER_REST_CONNECTION_PROFILE">
            <column name="profile"/>
        </constraint>
    </table>
</schema>
